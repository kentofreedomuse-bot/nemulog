<div class="auth-page">
  <header class="auth-header">
    <%= link_to root_path, class: "brand", aria: { label: "ねむログ ホーム" } do %>
      <span class="brand-mark">☾</span>
      <span><strong>ねむログ</strong><small>睡眠・服薬シンプル記録</small></span>
    <% end %>
  </header>

  <main class="auth-main">
    <section class="auth-card">
      <div class="auth-heading">
        <span class="auth-kicker">GET STARTED</span>
        <h1>アカウントを作成</h1>
        <p>毎日の睡眠と体調を、無理なく記録しましょう。</p>
      </div>

    <%= form_with model: @user, url: user_registration_path, id: 'new_user', class: 'new_user', local: true do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :nickname, "ニックネーム" %>
        <%= f.text_field :nickname, autofocus: true, autocomplete: "nickname" %>
      </div>

      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email %>
      </div>

      <div class="field">
        <%= f.label :password, "パスワード" %>
        <% if @minimum_password_length %>
          <em>（<%= @minimum_password_length %>文字以上）</em>
        <% end %>
        <%= f.password_field :password, autocomplete: "off" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "パスワード（確認）" %>
        <%= f.password_field :password_confirmation, autocomplete: "off" %>
      </div>

      <div class="actions">
        <%= f.submit "アカウントを作成する" %>
      </div>
    <% end %>

      <%= render "devise/shared/links" %>
    </section>
  </main>
</div>